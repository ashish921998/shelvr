#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(SHELVR_APP_ID)
SHELVR_APP_ID = app.shelvr.save.preview
INFOPLIST_KEY_CFBundleDisplayName = Shelvr Preview
SHELVR_VARIANT = development
SHELVR_CONVEX_URL = https:/$()/amicable-antelope-639.convex.cloud
SHELVR_URL_SCHEME = shelvr-preview
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf

#include? "Secrets.xcconfig"
SHELVR_REVENUECAT_KEY = $(EXPO_PUBLIC_REVENUECAT_TEST_KEY)
SHELVR_APNS_ENVIRONMENT = development
