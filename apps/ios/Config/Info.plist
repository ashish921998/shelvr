<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ShelvrPostHogToken</key>
    <string>$(SHELVR_POSTHOG_TOKEN)</string>
    <key>ShelvrPostHogHost</key>
    <string>$(SHELVR_POSTHOG_HOST)</string>
  <key>ShelvrAPNsEnvironment</key>
  <string>$(SHELVR_APNS_ENVIRONMENT)</string>
	<key>ShelvrRevenueCatKey</key>
    <string>$(SHELVR_REVENUECAT_KEY)</string>
	<key>ShelvrAppGroup</key>
	<string>group.$(SHELVR_APP_ID)</string>
	<key>ShelvrConvexURL</key>
	<string>$(SHELVR_CONVEX_URL)</string>
	<key>ShelvrVariant</key>
	<string>$(SHELVR_VARIANT)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Shelvr shows where you are on the map so you can find the places you saved nearby.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(SHELVR_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
