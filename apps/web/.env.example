CONVEX_URL=
# Optional. HTTP actions base URL (*.convex.site). Derived from CONVEX_URL when empty.
CONVEX_SITE_URL=
# Same value as the WAITLIST_SHARED_SECRET Convex deployment env var.
WAITLIST_SHARED_SECRET=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional. App Store Connect provider token (the `pt=` value from App Analytics >
# Campaigns). With it, App Store links carry `ct=` campaign tokens so installs
# show up per campaign; without it, links stay plain.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
