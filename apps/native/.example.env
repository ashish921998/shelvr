EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_AUTH_ENABLE_ANONYMOUS=
# RevenueCat (optional — entitlement stays "none" until keys are set)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# ActivationPal public app key (required for production iOS analytics)
ACTIVATION_PAL_IOS_KEY=
# Google Maps API key for expo-maps on Android (required for the map screen on Android)
# Create one at https://console.cloud.google.com/apis/credentials — restrict to Android apps
GOOGLE_MAPS_API_KEY=
# PostHog (optional — analytics is disabled until both values are set)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
