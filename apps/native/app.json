{
  "expo": {
    "name": "Shelvr",
    "slug": "shelvr",
    "scheme": "shelvr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf6ee",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c6c97aa7-6676-47a1-8ffc-9a1339c2bc19"
    },
    "ios": {
      "appleTeamId": "WJP847UZY2",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Shelvr uses your camera so you can capture things you want to save for later.",
        "NSPhotoLibraryUsageDescription": "Shelvr lets you save photos and screenshots from your library into your hub, and tidy your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Shelvr can save images back to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "app.shelvr.save"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6A23C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false,
      "package": "app.shelvr.save"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ExposureTrial-0.otf",
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Shelvr adds events to your calendar from things you've saved.",
          "remindersPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Shelvr lets you tidy your photo library — keep, delete, or save photos into your hub.",
          "savePhotosPermission": "Shelvr can save images back to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      "expo-maps",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6c97aa7-6676-47a1-8ffc-9a1339c2bc19",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "app.shelvr.save.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.shelvr.save"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "ashish921998"
  }
}
