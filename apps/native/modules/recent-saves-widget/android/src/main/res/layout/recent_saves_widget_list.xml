<?xml version="1.0" encoding="utf-8"?>
<!-- Three or more cells wide: the latest save featured on the left, the next
     four as rows that split the full height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/recent_saves_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/recent_saves_widget_background"
  android:clipToOutline="true"
  android:orientation="horizontal"
  android:padding="8dp">

  <FrameLayout
    android:id="@+id/list_featured"
    android:layout_width="124dp"
    android:layout_height="match_parent"
    android:background="@drawable/recent_saves_widget_tile"
    android:clipToOutline="true">

    <!-- A photo fills the card, center cropped, with the caption over a scrim. -->
    <FrameLayout
      android:id="@+id/list_featured_cover"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone">

      <ImageView
        android:id="@+id/list_featured_cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

      <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/recent_saves_widget_scrim" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
          android:id="@+id/list_featured_cover_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="#FFFFFFFF"
          android:maxLines="2"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_featured_cover_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="#CCFFFFFF"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </FrameLayout>

    <!-- Saves without a photo show their type icon above the caption. -->
    <LinearLayout
      android:id="@+id/list_featured_card"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
          android:id="@+id/list_featured_icon"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginBottom="4dp"
          android:importantForAccessibility="no"
          android:tint="@color/recent_saves_widget_accent" />

        <TextView
          android:id="@+id/list_featured_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/recent_saves_widget_foreground"
          android:maxLines="2"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_featured_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/recent_saves_widget_muted"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/list_row0"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="invisible">

      <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
          android:id="@+id/list_row0_image"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb"
          android:clipToOutline="true"
          android:importantForAccessibility="no"
          android:scaleType="centerCrop" />

        <FrameLayout
          android:id="@+id/list_row0_tile"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb">

          <ImageView
            android:id="@+id/list_row0_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/recent_saves_widget_accent" />
        </FrameLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/list_row0_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/recent_saves_widget_foreground"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_row0_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/recent_saves_widget_muted"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>

  <LinearLayout
      android:id="@+id/list_row1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="invisible">

      <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
          android:id="@+id/list_row1_image"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb"
          android:clipToOutline="true"
          android:importantForAccessibility="no"
          android:scaleType="centerCrop" />

        <FrameLayout
          android:id="@+id/list_row1_tile"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb">

          <ImageView
            android:id="@+id/list_row1_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/recent_saves_widget_accent" />
        </FrameLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/list_row1_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/recent_saves_widget_foreground"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_row1_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/recent_saves_widget_muted"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>

  <LinearLayout
      android:id="@+id/list_row2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="invisible">

      <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
          android:id="@+id/list_row2_image"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb"
          android:clipToOutline="true"
          android:importantForAccessibility="no"
          android:scaleType="centerCrop" />

        <FrameLayout
          android:id="@+id/list_row2_tile"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb">

          <ImageView
            android:id="@+id/list_row2_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/recent_saves_widget_accent" />
        </FrameLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/list_row2_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/recent_saves_widget_foreground"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_row2_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/recent_saves_widget_muted"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>

  <LinearLayout
      android:id="@+id/list_row3"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="invisible">

      <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
          android:id="@+id/list_row3_image"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb"
          android:clipToOutline="true"
          android:importantForAccessibility="no"
          android:scaleType="centerCrop" />

        <FrameLayout
          android:id="@+id/list_row3_tile"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/recent_saves_widget_thumb">

          <ImageView
            android:id="@+id/list_row3_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/recent_saves_widget_accent" />
        </FrameLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/list_row3_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/recent_saves_widget_foreground"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFamily="sans-serif-medium" />

        <TextView
          android:id="@+id/list_row3_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/recent_saves_widget_muted"
          android:maxLines="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
