<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview on Android 12+: the featured list with placeholders. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/recent_saves_widget_background"
  android:orientation="horizontal"
  android:padding="8dp">

  <FrameLayout
    android:layout_width="124dp"
    android:layout_height="match_parent"
    android:background="@drawable/recent_saves_widget_tile">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:src="@drawable/recent_saves_widget_photo"
      android:tint="@color/recent_saves_widget_accent" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/recent_saves_widget_thumb" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginEnd="24dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />

        <FrameLayout
          android:layout_width="56dp"
          android:layout_height="7dp"
          android:layout_marginTop="5dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/recent_saves_widget_thumb" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginEnd="24dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />

        <FrameLayout
          android:layout_width="56dp"
          android:layout_height="7dp"
          android:layout_marginTop="5dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/recent_saves_widget_thumb" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="9dp"
          android:layout_marginEnd="24dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />

        <FrameLayout
          android:layout_width="56dp"
          android:layout_height="7dp"
          android:layout_marginTop="5dp"
          android:background="@drawable/recent_saves_widget_preview_bar" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
