        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या नव्याने जतन केलेल्या गोष्टी, एका नजरेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpanan terkini anda, sepintas lalu."
