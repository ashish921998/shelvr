          "stringUnit": {
            "state": "translated",
            "value": "Tus últimos contenidos de un vistazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusimmat tallennuksesi yhdellä silmäyksellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos derniers contenus, en un coup d'œil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos derniers contenus, en un coup d'œil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી નવી સાચવેલી વસ્તુઓ, એક નજરમાં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים האחרונים שלך, במבט אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी नई सहेजी हुई चीज़ें, एक नज़र में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše najnovije stavke, na prvi pogled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legújabb mentéseid egy pillantással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpanan terbaru Anda, sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi ultimi contenuti a colpo d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近保存したものをひと目で確認。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೊಸ ಉಳಿಸಿದವು, ಒಂದೇ ನೋಟದಲ್ಲಿ."
