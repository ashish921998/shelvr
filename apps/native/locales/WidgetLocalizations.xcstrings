    "Your latest saves, at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر محفوظاتك في لمحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সাম্প্রতিক সংরক্ষিত জিনিস, এক নজরে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus últims continguts d'un cop d'ull."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nejnovější položky přehledně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit seneste indhold på et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neuesten Inhalte auf einen Blick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τελευταίες αποθηκεύσεις σου με μια ματιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest saves, at a glance."
          }
        },
