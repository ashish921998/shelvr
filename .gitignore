# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# pnpm content-addressable store — this repo was set up with a local store
# (./.pnpm-store/v10) instead of the global one (~/Library/pnpm/store). It's
# 2GB+ and required for node_modules symlinks to resolve, so leave it in place;
# just keep it out of git.
.pnpm-store

# testing
coverage

# next.js
.next/
.swc/
out/
build

# expo
.expo

# misc
.DS_Store
*.pem
dist

# Play API key written by release.yml from the
# EAS_GOOGLE_SERVICE_ACCOUNT_KEY secret; eas.json points at this path.
apps/native/google-service-account-key.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# turbo
.turbo

# typescript
*.tsbuildinfo
.gstack/

# Local AI-agent skills, configuration, and generated lockfiles
.agents/*
!.agents/setup
!.agents/resume
.claude/
.codex/
.cursor/
.gemini/
.kiro/
.opencode/
.vscode/
.zed/
skills-lock.json
opencode.json

# Argent tool cache (screen recordings, etc.). Keep Goldie's deterministic
# store flows versioned so the marketing captures remain reproducible.
.argent/
!/apps/native/.argent/
/apps/native/.argent/*
!/apps/native/.argent/flows/
/apps/native/.argent/flows/*
!/apps/native/.argent/flows/store-*.yaml
!/apps/native/.argent/flows/*-dev.yaml
.vercel

# Amp orb portal metadata
.amp/portals/

# Local build artifacts and stray root-level prebuild output — do not commit
tmp/
*.ipa
/ios/
/app.json

# App Store Connect CLI output; the analytics docs summarize what matters.
# The workflow definition is code and is tracked; reports and run state are not.
.asc/*
!.asc/workflow.json

# Store media and marketing assets live in the shelvr-notes repo
apps/native/store-assets/
assets/marketing/
assets/product-hunt/

# Claude Design sync: staged converter, its node_modules, compiled bundle, and
# machine state. All regenerate on the next sync; the rest of .design-sync/
# (config, notes, previews) is committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
