# Argent tool cache (screen recordings, etc.). Keep Goldie's deterministic
# store flows versioned so the marketing captures remain reproducible.
.argent/
!/apps/native/.argent/
/apps/native/.argent/*
!/apps/native/.argent/flows/
/apps/native/.argent/flows/*
!/apps/native/.argent/flows/*.yaml
.vercel

# Local build artifacts and stray root-level prebuild output — do not commit
tmp/
*.ipa
/ios/
/app.json
