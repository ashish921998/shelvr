# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# pnpm content-addressable store — this repo was set up with a local store
# (./.pnpm-store/v10) instead of the global one (~/Library/pnpm/store). It's
# 2GB+ and required for node_modules symlinks to resolve, so leave it in place;
# just keep it out of git.
.pnpm-store

# testing
coverage

# next.js
.next/
.swc/
out/
build

# expo
.expo

# misc
.DS_Store
*.pem
dist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# turbo
.turbo

# typescript
*.tsbuildinfo
.gstack/

