# Git exports GIT_DIR and its siblings to hooks, and they outrank the directory
# a command runs in. Clear them so the gate runs as it does in a shell and in CI.
for name in $(git rev-parse --local-env-vars); do unset "$name"; done

# The remote ref names the branch; the local one can be a bare commit ID.
while read -r _ local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  base=$remote_sha
  if ! git merge-base --is-ancestor "$base" "$local_sha" 2>/dev/null; then
    base=$(git merge-base "$local_sha" "refs/remotes/${1:-origin}/main" 2>/dev/null) ||
      base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) ||
      base=$(git merge-base "$local_sha" "$remote_sha" 2>/dev/null) ||
      base=$(git hash-object -t tree -w /dev/null)
  fi
  GIT_ATTR_SOURCE="$local_sha" git diff --check --no-ext-diff --no-textconv "$base" "$local_sha" -- >&2 || exit $?
done
