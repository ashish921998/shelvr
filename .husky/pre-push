# Git exports GIT_DIR and its siblings to hooks, and they outrank the directory
# a command runs in. Clear them so the gate runs as it does in a shell and in CI.
for name in $(git rev-parse --local-env-vars); do unset "$name"; done

# Only a push of branch commits needs the gate: not a delete, a tag or a no-op.
# The remote ref names the branch; the local one can be a bare commit ID.
gate=
while read -r _ sha ref _; do
  case $ref in refs/heads/*) case $sha in *[!0]*) gate=1 ;; esac ;; esac
done
[ -n "$gate" ] || exit 0

# The gate CI runs on every push. The dependency audit is left out: it needs
# the network, and a new advisory is not this change's fault.
pnpm run check:code
