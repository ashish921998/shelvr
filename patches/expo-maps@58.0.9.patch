+@available(iOS 17.0, *)
+struct CompactMapMarker: View {
+  let marker: MapMarker
+  let foreground: Color
+  let background: Color
+
+  private var isCluster: Bool {
+    Int(marker.monogram).map { $0 > 1 } ?? false
+  }
+
+  var body: some View {
+    VStack(spacing: 4) {
+      ZStack {
+        SwiftUI.Circle().fill(background)
+        SwiftUI.Circle().strokeBorder(marker.tintColor, lineWidth: 1.5)
+        if marker.hasMonogram {
+          Text(marker.monogram)
+            .font(.system(size: isCluster ? 14 : 18, weight: .semibold))
+            .lineLimit(1)
+            .minimumScaleFactor(0.5)
+            .foregroundStyle(foreground)
+        } else {
+          Image(systemName: marker.systemImage)
+            .font(.system(size: 16, weight: .medium))
+            .foregroundStyle(foreground)
+        }
+      }
+      .frame(width: 32, height: 32)
+      if !isCluster {
+        Text(marker.title)
+          .font(.custom("Satoshi-Medium", size: 13, relativeTo: .caption))
+          .foregroundStyle(foreground)
+          .lineLimit(1)
+          .truncationMode(.tail)
+          .padding(.horizontal, 8)
+          .padding(.vertical, 4)
+          .background(background, in: Capsule())
+          .frame(maxWidth: 136)
+      }
+    }
+    .fixedSize(horizontal: false, vertical: true)
+    .shadow(color: .black.opacity(0.12), radius: 3, x: 0, y: 1)
+    .accessibilityElement(children: .ignore)
+    .accessibilityLabel(marker.title)
+  }
+}
+
 enum MapContourStyle: String, Enumerable {
   case straight = "STRAIGHT"
   case geodesic = "GEODESIC"
