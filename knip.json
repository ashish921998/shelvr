{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".design-sync/**"],
  "workspaces": {
    "apps/native": {
      "entry": [
        "index.ts",
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/widgets/recent-saves-widget.tsx",
        "src/lib/revenuecat-api-key*.ts",
        "convex/**/*.ts",
        "modules/*/index.{ts,tsx}",
        "babel.config.js",
        "metro.config.js",
        "generateKeys.mjs",
        "goldie/goldie.config.ts",
        "plugins/with-widget-localization.js"
      ],
      "project": ["**/*.{js,mjs,ts,tsx}"],
      "ignore": ["convex/_generated/**"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    ".": {
      "entry": [
        "tools/generate-localizations.mjs",
        "tools/main-module.test.mjs",
        "tools/release-guards.test.mjs",
        "tools/verify-ci.cjs",
        "tools/verify-convex-codegen.mjs",
        "tools/verify-convex-codegen.test.mjs",
        "tools/verify-ios-submit.mjs",
        "tools/verify-native-fingerprint.mjs",
        "tools/verify-native-fingerprint.test.mjs",
        "tools/verify-ota-compatibility.mjs",
        "tools/verify-ota-compatibility.test.mjs",
        "tools/verify-ota-env.mjs"
      ],
      "project": ["tools/**/*.{mjs,cjs}"],
      "ignoreDependencies": ["expo-updates"]
    }
  }
}
