{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  "workspaces": {
    "apps/native": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/widgets/recent-saves-widget.tsx",
        "src/lib/revenuecat-api-key*.ts",
        "convex/*.ts",
        "convex/**/*.test.ts",
        "modules/*/index.{ts,tsx}",
        "generateKeys.mjs",
        "goldie/goldie.config.ts"
      ],
      "project": ["**/*.{js,mjs,ts,tsx}"],
      "ignore": ["convex/_generated/**"]
    },
    "tools/e2e": {
      "entry": ["e2e.config.ts", "tests/**/*.e2e.ts"],
      "project": ["**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    ".": {
      "entry": [
        "tools/git-trailer.test.mjs",
        "tools/main-module.test.mjs",
        "tools/measure-header-morph.mjs",
        "tools/release-guards.test.mjs",
        "tools/verify-ci.cjs",
        "tools/verify-convex-api.test.mjs",
        "tools/verify-convex-codegen.test.mjs",
        "tools/verify-native-fingerprint.test.mjs",
        "tools/verify-ota-compatibility.test.mjs"
      ],
      "project": ["tools/**/*.{mjs,cjs}"],
      "ignoreDependencies": ["expo-updates"]
    }
  }
}
