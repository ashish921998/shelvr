{
  "name": "shelvr",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter native-app test",
    "coverage": "pnpm --filter native-app test:coverage",
    "knip": "knip --reporter compact",
    "knip:dependencies": "knip --include dependencies,devDependencies,unlisted --reporter compact",
    "syncpack:lint": "syncpack lint",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run knip && pnpm run syncpack:lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.3",
    "syncpack": "^15.3.3",
    "turbo": "2.9.6"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@10.33.0",
  "version": "1.0.0"
}
